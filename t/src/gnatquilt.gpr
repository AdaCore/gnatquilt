project GNATquilt is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   for Main use ("gnatquilt.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-fpreserve-control-flow", "-fdump-scos", "-g", "-O0");
   end Compiler;

end GNATquilt;
